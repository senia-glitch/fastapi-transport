# fastbase: generated
# Настройки пакета fastbase. Префикс FAT_.

# --- API ---
FAT_TITLE=API
FAT_VERSION=0.0.0
FAT_DESCRIPTION=
FAT_API_PREFIX=/api/v1

# --- Docs ---
FAT_DOCS_URL=/docs
FAT_OPENAPI_URL=/openapi.json
FAT_REDOC_URL=/redoc

# --- Request-ID ---
FAT_REQUEST_ID_ENABLED=true
FAT_REQUEST_ID_HEADER=X-Request-ID

# --- Logging ---
FAT_LOG_LEVEL=info
FAT_LOG_FORMAT=plain
FAT_ACCESS_LOG=true

# --- Errors ---
FAT_ERROR_CODE_FALLBACK=3500
# FAT_ERROR_CODES={"UserNotFoundError": 2001}

# --- Uvicorn ---
FAT_HOST=127.0.0.1
FAT_PORT=8000
FAT_RELOAD=false
FAT_WORKERS=1
FAT_BACKLOG=2048
FAT_TIMEOUT_KEEP_ALIVE=5
FAT_ROOT_PATH=
FAT_APP_PATH=app.main:app